{
  "name": "@drip/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "Drip Fantasy native app (Expo). Player surfaces only — admin and commissioner tools stay on the web.",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit"
  },
  "//": "Native module versions are the ones Expo SDK 57 pins in its bundledNativeModules.json. `npx expo install` normally resolves these; it needs api.expo.dev, so if that is unreachable read that file instead of guessing.",
  "dependencies": {
    "@drip/core": "*",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "expo": "^57.0.12",
    "expo-constants": "~57.0.10",
    "expo-linking": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "^19.2.3",
    "react-native": "0.86.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "*",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.1",
    "typescript": "~5.9.2"
  }
}
