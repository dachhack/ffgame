{
  "name": "@drip/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "Drip Fantasy native app (Expo). Player surfaces only — admin and commissioner tools stay on the web.",
  "scripts": {
    "start": "EXPO_NO_METRO_LAZY=1 expo start --dev-client",
    "ios": "EXPO_NO_METRO_LAZY=1 expo run:ios",
    "android": "EXPO_NO_METRO_LAZY=1 expo run:android",
    "prebuild": "expo prebuild --clean",
    "bundle": "expo export --platform all --output-dir dist",
    "typecheck": "tsc --noEmit",
    "apk": "eas build --profile preview --platform android",
    "apk:local": "eas build --profile preview --platform android --local",
    "ios:simulator": "eas build --profile preview-simulator --platform ios"
  },
  "//scripts": "EXPO_NO_METRO_LAZY=1 on the dev-server scripts: without it Metro serves each dynamic import() as a separate lazy bundle, and core's `import('@supabase/supabase-js')` (supabaseClient.ts) came back as 'Requiring unknown module' in the iOS dev build. Release builds inline every import already, so this only makes dev behave like what ships.",
  "//": "Native module versions are the ones Expo SDK 57 pins in its bundledNativeModules.json. `npx expo install` normally resolves these; it needs api.expo.dev, so if that is unreachable read that file instead of guessing.",
  "dependencies": {
    "@drip/core": "*",
    "@formatjs/intl-datetimeformat": "^7.6.0",
    "@formatjs/intl-getcanonicallocales": "^3.2.11",
    "@formatjs/intl-locale": "^5.3.10",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "expo": "~57.0.25",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.20",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "react": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "*",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.15.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.1",
    "typescript": "~5.9.2"
  }
}
