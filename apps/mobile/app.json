{
  "expo": {
    "name": "Drip Fantasy",
    "icon": "./assets/icon.png",
    "slug": "drip-fantasy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "dripfantasy",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dripfantasy.app"
    },
    "android": {
      "package": "com.dripfantasy.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#163138"
      }
    },
    "extra": {
      "//": "Build-time config for core's platform shim. Deliberately EMPTY: unset keys fall through to the production defaults in packages/core/src/data/liveConfig.ts, so a plain build is a working production build. To point at another project, set VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY / VITE_YAHOO_CLIENT_ID / VITE_MARK_FREE in the environment — app.config.js layers them in. See the header there."
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#34E5D9"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#163138"
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-web-browser",
      "./plugins/withCoreBundleInput",
      "./plugins/withPlaytestSigning",
      "./plugins/withReleaseShrink"
    ]
  }
}